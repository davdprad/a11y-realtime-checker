{
  "name": "a11y-rt",
  "description": "Extensão Chromium (MV3) que verifica continuamente o DOM renderizado e sinaliza violações WCAG 2.2 em tempo real.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "wxt",
    "build": "pnpm gen:messages && wxt build",
    "build:test": "pnpm gen:messages && wxt build --mode test",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:aria": "tsx scripts/gen-aria-data.ts",
    "gen:bcp47": "tsx scripts/gen-bcp47-data.ts",
    "gen:fixtures": "tsx scripts/gen-fixtures.ts",
    "fetch:act": "tsx scripts/fetch-act.ts",
    "serve": "tsx scripts/serve.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:act": "playwright test --project=act",
    "test:dynamic": "playwright test --project=dynamic",
    "test:perf": "playwright test --project=perf",
    "test:ui": "playwright test --project=ui",
    "test": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm build:test && pnpm test:e2e",
    "gen:messages": "tsx scripts/gen-messages.ts"
  },
  "dependencies": {
    "@medv/finder": "4.0.2",
    "dom-accessibility-api": "0.7.1",
    "preact": "10.29.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/aria-query": "5.0.4",
    "@types/chrome": "0.3.5",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "aria-query": "5.3.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
